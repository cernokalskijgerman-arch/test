<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Official Nothing OS Glyph Hardware Permissions -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="com.nothing.glyph.permission.GLYPH" />

    <!-- Permissions for Audio Visualizer, Background Service & Haptics -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Nothing OS Package Visibility queries for IPC Service Binding -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
        <intent>
            <action android:name="com.nothing.thirdparty.bind_glyphservice" />
        </intent>
    </queries>

    <application
        android:name=".GlyphStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphStudio"
        tools:targetApi="34">

        <!-- Nothing Developer Key (use 'test' for development / debug builds) -->
        <meta-data android:name="NothingKey" android:value="test" />
        <meta-data android:name="targetNothingSDKVersion" android:value="140101" />
        <meta-data android:name="TargetDevice" android:value="A059" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.GlyphStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter for opening .glyph animation files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.glyph" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GlyphForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Nothing Phone Glyph background animation &amp; timer controller" />
        </service>
    </application>

</manifest>
